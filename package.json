{
  "name": "aaarchive",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@aaarchive/shared' build && bun run --filter '*' dev",
    "dev:web": "bun run --filter '@aaarchive/web' dev",
    "dev:api": "bun run --filter '@aaarchive/api' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "postinstall": "bun run --filter '@aaarchive/shared' build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
