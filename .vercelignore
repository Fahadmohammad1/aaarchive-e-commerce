# What `vercel deploy` must not upload (it does not read .gitignore).
# Secrets: values live in the Vercel project settings, never in the upload.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output (Vercel installs and builds itself)
node_modules
**/node_modules
**/.next
**/dist
**/out
**/coverage
**/*.tsbuildinfo
apps/api/src/generated

# Tests and local tooling
**/test-results
**/playwright-report
.github
.claude
*.log
*.pem
