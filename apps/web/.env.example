# Copy to .env.local and fill in. Never commit real values.

# Browser-facing API base. Relative on purpose: next.config.ts rewrites it to
# API_PROXY_TARGET so auth cookies stay first-party (see docs/architecture.md §3.4).
NEXT_PUBLIC_API_URL=/api/v1

# Where the NestJS backend actually runs (server-side only).
API_PROXY_TARGET=http://localhost:4000/api/v1

# Public site origin, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Added by proxy.ts to every /api/v1 request so the API knows the
# request came through this website. Must equal API_PROXY_SECRET in the API.
API_PROXY_SECRET=

# Shared secret the backend sends to /api/revalidate after catalog/stock changes.
REVALIDATE_SECRET=

# Third-party public IDs (all free tiers).
# Cloudflare Turnstile site key (dashboard login). Empty locally = no widget.
# Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public URL prefix of the Supabase Storage "media" bucket (must match the API).
NEXT_PUBLIC_MEDIA_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
