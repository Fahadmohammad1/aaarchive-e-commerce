# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# Supabase: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aaarchive
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/aaarchive

FRONTEND_ORIGIN=http://localhost:3000

# Frontend cache webhook; must match REVALIDATE_SECRET in the frontend.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Added as their modules are built (Phase 0+):
# JWT_ACCESS_SECRET= JWT_REFRESH_SECRET=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=
# CLOUDINARY_CLOUD_NAME= CLOUDINARY_API_KEY= CLOUDINARY_API_SECRET=
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
