# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# Supabase (Project → Connect). Supabase is used only as Postgres.
# Runtime: TRANSACTION pooler, port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (Prisma CLI): SESSION pooler, port 5432 (direct db.<ref> host is IPv6-only on free tier).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

FRONTEND_ORIGIN=http://localhost:3000

# Frontend cache webhook; must match REVALIDATE_SECRET in the frontend.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Added as their modules are built (Phase 0+):
# JWT_ACCESS_SECRET= JWT_REFRESH_SECRET=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=
# CLOUDINARY_CLOUD_NAME= CLOUDINARY_API_KEY= CLOUDINARY_API_SECRET=
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
