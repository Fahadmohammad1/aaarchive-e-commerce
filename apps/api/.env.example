# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=4000

# Supabase (Project → Connect). Supabase is used only as Postgres.
# Runtime: TRANSACTION pooler, port 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (Prisma CLI): SESSION pooler, port 5432 (direct db.<ref> host is IPv6-only on free tier).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

FRONTEND_ORIGIN=http://localhost:3000

# Frontend cache webhook; must match REVALIDATE_SECRET in the frontend.
# Required in production. Generate: openssl rand -hex 32
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=

# Shared secret the web proxy adds to every API request (header
# x-aaarchive-proxy). Must match API_PROXY_SECRET in the web app. Required in
# production; leave empty locally to allow direct calls.
# Generate: openssl rand -hex 32
API_PROXY_SECRET=

# Reverse proxies in front of the API (0 locally; set at deploy, see
# docs/architecture.md §4.11).
TRUST_PROXY=0

# Global rate limit per client IP.
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60

# ── Auth (rules.md §8.2) ──
# Access-token signing key. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Cloudflare Turnstile secret. Empty locally = bot check skipped. Required in production.
# Test key that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# First Owner account, created by `db:seed` if the email is unused.
# Remove SEED_OWNER_PASSWORD from .env after seeding.
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── Customer accounts: Google sign-in (optional; empty = button hidden) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <FRONTEND_ORIGIN>/api/v1/account/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── SSLCommerz online payment (off until the Owner turns it on in Settings) ──
# Empty = cannot be turned on. Sandbox store: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# true = sandbox (no real money). false only with a live merchant store.
SSLCOMMERZ_SANDBOX=true
# Unpaid online-payment orders are cancelled (stock returned) after this many minutes.
SSLCOMMERZ_PAYMENT_WINDOW_MINUTES=45
# ── Media: Supabase Storage via its S3 API (docs/architecture.md §4.7a) ──
# Supabase → Project Settings → Storage → S3 Connection. Storage-only keys;
# never put the service_role key here.
MEDIA_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_BUCKET=media
# Public URL prefix of the bucket (served to browsers).
MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# ── Email: Resend free tier (order confirmations). Empty = emails skipped. ──
# MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=

# ── Two-factor sign-in: encrypts authenticator keys. Required in production. ──
# Generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Public site origin (links in the Facebook catalog feed).
SITE_URL=http://localhost:3000

# Sentry error monitoring (free tier). Empty = off.
SENTRY_DSN=
